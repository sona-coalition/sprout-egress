# ============================================================================
# agent/Containerfile — the image Sprout runs inside.
#
# Think of an image as a sealed, reproducible mini-computer: same tools,
# same versions, every time, on any host. This one contains the Pi agent
# and the command-line tools Sprout's procedures rely on. It contains NO
# secrets and NO state — those arrive at runtime (env file and mounts).
#
# Build (start.sh does this):  podman build -t sprout -f agent/Containerfile agent
# ============================================================================

# Base layer: Debian 13 ("trixie"), slim variant, with Node.js 22 included.
# Small, current, and from a well-known source (Docker's official node images).
FROM node:22-trixie-slim

# Tools Sprout uses directly:
#   git            - commits, branches, pushes (its record-keeping)
#   curl           - calling REST/GraphQL/MCP endpoints
#   ca-certificates- so HTTPS connections can be verified
#   python3        - small utilities (e.g. ontology checks, render scripts)
#   fd-find, ripgrep - pi's file-search companions. Installing them here,
#     from the Debian archive (same trust as the base image), means pi does
#     not try to download them at runtime — which would need a whole
#     user-content CDN (githubusercontent.com) in the egress allowlist.
#     Debian names the binaries fdfind and rg; add the names pi looks for.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates python3 fd-find ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && ln -s /usr/bin/rg /usr/local/bin/ripgrep

# The Pi coding agent itself, installed globally from npm.
RUN npm install -g @earendil-works/pi-coding-agent

# Pi configuration: default to the SAME model and thinking level Sprout uses
# on Superconductor (moonshotai/kimi-k3, reasoning max), so the container
# instance is the same mind, not just the same instructions. The apiKey value
# is the literal string "$OPENROUTER_API_KEY" — pi expands it from the
# environment at call time, so no secret is baked into the image.
RUN mkdir -p /root/.pi/agent
COPY pi-settings.json /root/.pi/agent/settings.json
COPY pi-models.json /root/.pi/agent/models.json

# Git identity: Sprout acts on GitHub as "sprout-graft", and its commits and
# pull requests are recorded as sprout-graft <sprout-graft@omail.sh>.
# Setting this system-wide in the image keeps that identity consistent
# without any per-run configuration. Also default new repos to branch "main".
RUN git config --system user.name "sprout-graft" \
 && git config --system user.email "sprout-graft@omail.sh" \
 && git config --system init.defaultBranch main

# Credentials: plain `git push`/`pull`/`clone` over HTTPS must work without
# prompts. This helper answers git's credential questions from the GH_TOKEN
# environment variable AT CALL TIME — nothing secret is stored in the image;
# the token still arrives only through the env file. Found missing by the
# first container run (2026-11-01: commit worked, push prompted and failed).
RUN git config --system credential.helper '!f() { echo "username=x-access-token"; echo "password=$GH_TOKEN"; }; f'

# The two mount points start.sh binds to. They MIRROR the host layout —
# the rule is "same path inside the container as outside it":
#   host sprout-harness/sprout/                -> /home/sprout/sprout
#   host sprout-harness/sprout/sprout-private/ -> /home/sprout/sprout/sprout-private
# Creating them here just means the directories exist even if nothing is
# mounted (start.sh refuses to run without the mounts anyway).
RUN mkdir -p /home/sprout/sprout/sprout-private
WORKDIR /home/sprout/sprout

# When the container starts interactively, give the operator a shell.
# The operator (or a runbook procedure) then runs `pi` themselves.
CMD ["bash"]
